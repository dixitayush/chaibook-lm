# Required: at least one LLM provider
# OpenAI — embeddings, chat, and podcast TTS
OPENAI_API_KEY=

# Gemini — embeddings + chat (podcast falls back to browser voices)
GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=   # alias for GEMINI_API_KEY

# Optional model overrides
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Gemini defaults when only GEMINI_API_KEY is set:
# CHAT_MODEL=gemini-2.0-flash
# EMBEDDING_MODEL=text-embedding-004

# Postgres + pgvector (required)
# docker compose up -d
DATABASE_URL=postgres://chaibook:chaibook@localhost:5433/chaibook

# Redis — short-term notebook memory (LRU) + API rate limits
# docker compose up -d starts Redis on 6379. Optional locally; required in production compose.
REDIS_URL=redis://127.0.0.1:6379

# Optional: Mem0 cloud long-term memory. Local Postgres memories still work without this.
MEM0_API_KEY=

# Optional TTS voice names (OpenAI)
PODCAST_VOICE_MALE=onyx
PODCAST_VOICE_FEMALE=nova

# Optional: Google sign-in + Gmail/Calendar/Drive as notebook sources.
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web application)
# Authorized JavaScript origins: http://localhost:3000
# Authorized redirect URI — this exact string, no trailing slash:
#   http://localhost:3000/api/gmail/callback
# (Sign-in and Gmail/Calendar/Drive all use that one callback.)
# APP_URL must be a browser-reachable origin (localhost or your public host).
# Never set it to 0.0.0.0 — that is only the server bind address.
# Enable Gmail API, Google Calendar API, and Google Drive API for source import.
# While the consent screen is in Testing, add your Gmail under Test users or Google returns 403 access_denied.
APP_URL=http://localhost:3000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: send share invites and chat transcripts by email (https://resend.com)
# MAIL_FROM=ChaiBook LM <you@yourdomain.com>
RESEND_API_KEY=

# MCP tools (GitHub, Jira, Postgres, Notion, custom)
# Connect per notebook in Studio → Tools. Tokens are stored on the notebook, not here.
# Paste Claude / VS Code / Cursor MCP JSON, or use a preset.
# Stdio servers (`npx -y @modelcontextprotocol/server-github`, …) work with `next dev` locally.
# In production, paste an HTTP MCP URL instead of a local command.

# VPS deploy: from repo root run ../setup.sh once, then ./deploy.sh here.
# See ../DEPLOYMENT.md. Traefik terminates TLS; Caddy is private.
# On the server, set these (uncomment / replace the local APP_URL above):
# CHAIBOOK_HOST=chaibook.ayushdixit.work
# APP_URL=https://chaibook.ayushdixit.work
# POSTGRES_PASSWORD=change-me
